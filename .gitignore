.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
#  JetBrains specific template is maintainted in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Claude Code: machine-local and session scaffolding never ship. The exemplar skill and the shared
# settings.json (a worked example of scoping agent tool-call approvals) are deliberately tracked;
# agent definitions are owner-local working machinery, not part of the product.
.claude/settings.local.json
.claude/agents/
CLAUDE.local.md

# Local backlog and short-lived plans are private; keep open work in plans/backlog.md.
# Agent scratch files and task artifacts are private.
/plans/
.claude/plans/

# Eval run outputs: a transcript captures workspace_orient output (hub name, project URNs) - private,
# never committed (see tests/live/evals/README.md "Privacy"). The scenarios are tracked; results are not.
tests/live/evals/results/
# The proctor's executor config dir: the CLI's own state files for the blind executor.
tests/live/evals/.claude-eval/
# The bare-wire measurement marker: while present, tools/list carries no descriptions.
commands/mcpServer/.wire_bare

# The opt-in cloud tier's operator config: it names a real hub, project and folder, which are
# private and machine-local. Without it the cloud_tier capability probe answers false and ACT 11a-c
# are skipped - see tests/live/cloud_config.py for the shape.
tests/live/cloud_config.local.json

# measure_api / tool_verify run archives: per-run records; the durable state they feed
# (tests/live/CONTRACTS.md + tests/live_api_facts.py + tests/live/VERIFIED_TOOLS.md) is tracked,
# the archives are not.
tests/live/results/

/outputs/
